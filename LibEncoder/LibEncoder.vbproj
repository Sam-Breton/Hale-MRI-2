<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>LibEncoder</RootNamespace>
		<!-- Locked to Windows to support the unmanaged USDigital driver stack natively -->
		<TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
		<Platforms>x64</Platforms>
		<!-- Stripped AnyCPU out entirely -->
		<ImportedNamespaces>LibGlobals=False,USB4Wrapper=False,Microsoft.VisualBasic=True,System=True,System.Collections=True,System.Collections.Generic=True,System.Diagnostics=True,System.Linq=True,System.Xml.Linq=True,System.Threading.Tasks=True,LibEncoder=True</ImportedNamespaces>
		<Configurations>Debug;Release</Configurations>
		<!-- Forces MSBuild to resolve processor mismatches down to the active selection -->
		<ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
		<DoNotCombineProcessorArchitectures>true</DoNotCombineProcessorArchitectures>
		<AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
		<Configurations>Release;Debug</Configurations>
	</PropertyGroup>

	<!-- Explicit x64 Mapping (Guarantees native 64-bit execution for BOTH Debug and Release) -->
	<PropertyGroup Condition="'$(Platform)' == 'x64'">
		<PlatformTarget>x64</PlatformTarget>
		<RuntimeIdentifier Condition="'$(Configuration)' == 'Release'">win-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="'$(Configuration)' == 'Debug'">win-x64</RuntimeIdentifier>
		<SelfContained>false</SelfContained>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="ThirdPartyClient.vb" />
		<Compile Remove="ThirdPartyProcessManager.vb" />
	</ItemGroup>

	<ItemGroup>
		<Import Include="LibGlobals" />
		<Reference Include="USB4Wrapper"></Reference>
		<Import Include="USB4Wrapper" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\LibGlobals\LibGlobals.vbproj" />
	</ItemGroup>

</Project>